{
  "manifest_version": 3,
  "name": "Narekan Plus",
  "version": "0.1.0",
  "description": "ナレカン（narekan.jp）を拡張するツールキット。よくある質問（FAQ）のお気に入り等。",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "action": { "default_popup": "popup/popup.html" },
  "content_scripts": [
    {
      "matches": ["https://www.narekan.jp/*", "https://narekan.jp/*"],
      "js": ["src/core/featureManager.js", "src/features/favoriteFaqs.js", "src/content.js"],
      "css": ["src/styles/narekan-plus.css"],
      "run_at": "document_idle"
    }
  ]
}
